# Replace with your public hostname. The TLS proxy must preserve this Host header.
EPUB_DOCTOR_PUBLIC_ORIGIN=https://epubdoctor.example.org
EPUB_DOCTOR_HTTP_PORT=8080
EPUB_DOCTOR_TELEMETRY_ENABLED=0
# Size-based rotation: 10 MiB per file, plus five archives; no age-based deletion.
EPUB_DOCTOR_TELEMETRY_MAX_BYTES=10485760
EPUB_DOCTOR_TELEMETRY_BACKUP_COUNT=5
